APP_NAME="Academic Grading System"
APP_ENV=production
APP_TIMEZONE=Africa/Mogadishu
APP_BASE_PATH=

# SQLite (quick start). Use an absolute writable path outside the public web root in production.
DB_DSN="sqlite:/absolute/private/path/grading.sqlite"
DB_USERNAME=
DB_PASSWORD=

# MySQL alternative:
# DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=grading;charset=utf8mb4"
# DB_USERNAME=grading_user
# DB_PASSWORD=replace-with-a-long-random-password

SESSION_NAME=grading_session
SESSION_LIFETIME=7200

# Used only when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD="replace-with-a-strong-temporary-password"
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
ADMIN_EMAIL=admin@example.com
